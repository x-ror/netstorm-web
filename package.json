{
  "name": "netstorm-web",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @netstorm/client",
    "build": "npm run build -w @netstorm/client",
    "test": "npm test -w @netstorm/sim",
    "typecheck": "npm run typecheck --workspaces",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run check:size",
    "check:size": "node scripts/check-size.mjs",
    "test:browser": "node scripts/smoke-browser.mjs",
    "benchmark": "node --import tsx scripts/benchmark-sim.ts",
    "prepare": "husky",
    "lint:commit": "commitlint",
    "lint:commits": "commitlint --verbose",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint:staged": "lint-staged"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "dprint": "^0.62.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
